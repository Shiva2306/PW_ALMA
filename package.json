  "main": "index.js",
  "scripts": {
    "test:master": "playwright test --grep @master --headed",
    "test:sanity": "playwright test --grep @sanity",
    "test:sanity:headed": "playwright test --grep @sanity --headed",
    "test:regression": "playwright test --grep @regression --headed",
    "test:datadriven": "playwright test --grep @datadriven --headed",
    "test:master:headed": "playwright test --grep @master --headed",
    "allure:report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "clean": "rimraf allure-results allure-report",
   "test:sanity:clean": "npm run clean && npm run test:sanity:headed"
  },
